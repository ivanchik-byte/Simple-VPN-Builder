# ==============================================================================
# Simple VPN Builder - Environment Configuration
# ==============================================================================

# Database & Cache (PostgreSQL 16+ and Redis 7+)
VPNBUILDER_DATABASE_DSN=postgres://vpnbuilder:vpnbuilder@localhost:5432/vpnbuilder?sslmode=disable
VPNBUILDER_DATABASE_MAX_OPEN_CONNS=25
VPNBUILDER_DATABASE_MAX_IDLE_CONNS=5
VPNBUILDER_DATABASE_CONN_MAX_LIFETIME=5m
VPNBUILDER_DATABASE_CONN_MAX_IDLE_TIME=1m
VPNBUILDER_REDIS_ADDR=localhost:6379
VPNBUILDER_REDIS_PASSWORD=
VPNBUILDER_REDIS_DB=0

# Server Network Addresses
VPNBUILDER_SERVER_HTTP_ADDR=:8110
VPNBUILDER_SERVER_GRPC_ADDR=:9090
VPNBUILDER_SERVER_TLS_CERT=
VPNBUILDER_SERVER_TLS_KEY=
# Comma-separated list of allowed CORS origins
VPNBUILDER_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Authentication & Security
VPNBUILDER_AUTH_JWT_SECRET=change-this-to-a-secure-random-64-character-secret
VPNBUILDER_AUTH_JWT_ACCESS_TTL=15m
VPNBUILDER_AUTH_JWT_REFRESH_TTL=168h
VPNBUILDER_AUTH_BCRYPT_COST=12
CONTROL_PLANE_API_KEY=dev-api-key-change-in-production

# Telegram Sales Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_BOT_TOKEN=
CRYPTOBOT_TOKEN=
CONTROL_PLANE_URL=http://localhost:8110

# Initial admin seeding (scripts/seed_admin.go)
# NOTE: SEED_ADMIN_PASSWORD has no default and is required when seeding.
SEED_ADMIN_EMAIL=admin@vpnbuilder.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=superadmin

# Internal Certificate Authority (mTLS)
VPNBUILDER_CA_CERT_TTL=720h
VPNBUILDER_CA_CERT_FILE=/etc/vpnbuilder/ca.pem
VPNBUILDER_CA_KEY_FILE=/etc/vpnbuilder/ca-key.pem

# WireGuard adapter defaults
VPNBUILDER_ADAPTER_WIREGUARD_INTERFACE_PREFIX=wg
VPNBUILDER_ADAPTER_WIREGUARD_SUBNET_V4=10.8.0.0/16
VPNBUILDER_ADAPTER_WIREGUARD_SUBNET_V6=fd00::/64
VPNBUILDER_ADAPTER_WIREGUARD_DNS=1.1.1.1,1.0.0.1
VPNBUILDER_ADAPTER_WIREGUARD_MTU=1280
VPNBUILDER_ADAPTER_WIREGUARD_KEEPALIVE=25

# Node Agent (cmd/agent)
VPNBUILDER_AGENT_NODE_NAME=
VPNBUILDER_AGENT_CONTROL_PLANE=
VPNBUILDER_AGENT_CA_CERT=
VPNBUILDER_AGENT_CERT_FILE=
VPNBUILDER_AGENT_KEY_FILE=
VPNBUILDER_AGENT_SYNC_INTERVAL=30s
VPNBUILDER_AGENT_METRICS_INTERVAL=30s
VPNBUILDER_AGENT_WIREGUARD_INTERFACE_PREFIX=wg
VPNBUILDER_AGENT_WIREGUARD_SUBNET_V4=10.8.0.0/16
VPNBUILDER_AGENT_WIREGUARD_SUBNET_V6=fd00::/64
VPNBUILDER_AGENT_WIREGUARD_DNS=1.1.1.1,1.0.0.1
VPNBUILDER_AGENT_WIREGUARD_MTU=1280

# Logging
VPNBUILDER_LOG_LEVEL=info
VPNBUILDER_LOG_FORMAT=json
