# ==============================================================================
# Simple VPN Builder - Environment Configuration
# ==============================================================================

# Database & Cache (PostgreSQL 16+ and Redis 7+)
VPNBUILDER_DATABASE_DSN=postgres://vpnbuilder:vpnbuilder@localhost:5432/vpnbuilder?sslmode=disable
VPNBUILDER_REDIS_ADDR=localhost:6379

# Server Network Addresses
VPNBUILDER_SERVER_HTTP_ADDR=:8110
VPNBUILDER_SERVER_GRPC_ADDR=:9090

# Authentication & Security
VPNBUILDER_AUTH_JWT_SECRET=change-this-to-a-secure-random-64-character-secret
VPNBUILDER_AUTH_JWT_ACCESS_TTL=15m
VPNBUILDER_AUTH_JWT_REFRESH_TTL=168h
VPNBUILDER_AUTH_BCRYPT_COST=12
CONTROL_PLANE_API_KEY=dev-api-key-change-in-production

# Telegram Sales Bot
TELEGRAM_BOT_TOKEN=
CRYPTOBOT_TOKEN=
CONTROL_PLANE_URL=http://localhost:8110

# Logging
VPNBUILDER_LOG_LEVEL=info
VPNBUILDER_LOG_FORMAT=json
